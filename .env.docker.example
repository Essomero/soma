# Soma — Docker / Fly / Railway env example
# Copy to .env when using `docker compose up` or `npm run start` locally.
# For Fly.io / Railway / Render: set these as secrets/env vars in the dashboard.

# Required: owner login password for your private studio
# Generate: openssl rand -base64 32
SITE_PASSWORD=change-me-to-a-strong-password

# Optional: use hosted Turso instead of local SQLite file.
# Omit both to use local SQLite (file:./data/soma.db) — no Turso account needed.
# Get free: turso db create soma-db && turso db show soma-db --url && turso db tokens create soma-db
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# Optional: override local SQLite path (inside container /data is the volume)
# DATABASE_URL=file:./data/soma.db
# SQLITE_PATH=/data/soma.db

# Optional AI keys (same as in .env.example)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# STRAITLY_API_KEY=
# UNSPLASH_ACCESS_KEY=

# Port (Fly/Railway set PORT automatically; respect that)
# PORT=3000
