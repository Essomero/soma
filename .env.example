# ==============================================================================
# Soma — Environment Configuration (.env.example)
#
# Single template for all deploy targets: Docker, Fly.io, Railway, Render,
# Vercel, and local dev. Copy to .env.local (gitignored) for dev, or set as
# secrets/env vars in your platform dashboard for production.
#
#   cp .env.example .env.local   (local dev / docker compose)
#   Vercel: Project Settings > Environment Variables
#   Fly.io: fly secrets set KEY=value
#   Railway/Render: dashboard > Variables
#
# Rule: secrets never committed, never have defaults.
# Blank = not configured. Missing OPTIONAL = feature off.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — owner login (always required, every deploy target)
# ------------------------------------------------------------------------------

# Master password for your private studio (login gate, author controls).
# Pick any strong string: openssl rand -base64 32
# Vercel / Fly / Railway: mark as Sensitive if the platform supports it.
SITE_PASSWORD=your-secure-site-password

# ------------------------------------------------------------------------------
# DATABASE — pick one path (Turso remote OR local SQLite file)
# ------------------------------------------------------------------------------
#
# Toggle: USE_TURSO=false (default) -> local SQLite file. USE_TURSO=true -> Turso remote.
# Set to true/false, yes/no, 1/0, on/off. Defaults to false (local) when missing.
# Vercel: set USE_TURSO=true alongside TURSO_* vars. Docker: leave false for isolation.
USE_TURSO=false
#
# Vercel path (original, still supported, needs USE_TURSO=true):
#   Set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN. Tables self-create on first request.
#   Get one free: turso db create soma-db && turso db show soma-db --url
#   Token: turso db tokens create soma-db
#
# Docker / Fly / Railway / self-hosted path (new, no Turso account needed):
#   Leave USE_TURSO=false (default) — Soma uses a local SQLite file (./data/soma.db in repo,
#   /app/data/soma.db or /data/soma.db inside containers on a volume).
#   The same image uses Turso when USE_TURSO=true + TURSO_* are present.
#
# Official Turso names; legacy TURSO_DB / TURSO_TOKEN still accepted as fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: override local SQLite path for Docker / self-hosted.
# Inside Docker, the volume default is /app/data/soma.db (or /data/soma.db on Fly).
#   DATABASE_URL=file:./data/soma.db          (Prisma-style, optional)
#   SQLITE_PATH=/app/data/soma.db             (simpler, optional)
# Omit both to use default ./data/soma.db
# DATABASE_URL=
# SQLITE_PATH=

# ------------------------------------------------------------------------------
# OPTIONAL — AI providers (at least one enables margin AI and research chat;
# with none configured, reading, writing, and publishing work unchanged)
# ------------------------------------------------------------------------------

# Unified router for Claude, GPT, Gemini, Llama, Qwen via one endpoint.
OPENROUTER_API_KEY=

# Straitly AI gateway (100+ models, single endpoint).
STRAITLY_API_KEY=

# DeepSeek direct API.
DEEPSEEK_API_KEY=

# Google Gemini API.
GEMINI_API_KEY=
# Set to 1 to force-disable direct Gemini even when a key is present.
GEMINI_DISABLED=0

# Groq fast inference (Llama, Mixtral).
GROQ_API_KEY=

# Cerebras fast inference.
CEREBRAS_API_KEY=

# Unsplash API access key for in-app cover image search.
# Get one: https://unsplash.com/developers → "Register as a developer" → "New Application"
# Unsplash's UI calls this "App ID" — either UNSPLASH_ACCESS_KEY or UNSPLASH_APP_ID works.
UNSPLASH_ACCESS_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — local development only (never set VITE_* in production)
# ------------------------------------------------------------------------------

# Son voice agent backend for oral tests. Defaults to http://localhost:7860.
# Only needed when running son locally alongside `npm run dev`.
VITE_SON_BACKEND_URL=

# Direct browser-to-Turso access for offline local work (LOCAL_API=1).
# WARNING: values here are baked into the shipped JS bundle.
# Never set VITE_TURSO_* in Vercel / Fly / Railway. Production always goes through /api/*.
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=
