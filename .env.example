# ==============================================================================
# Soma — Environment Configuration Template (.env.example)
#
# Setup:
#   Local dev:  cp .env.example .env.local   (gitignored, never commit secrets)
#   Vercel:     fill these in the dashboard (Project Settings > Environment
#               Variables) or via `vercel env add <KEY> production`.
#               Mark TURSO_AUTH_TOKEN and SITE_PASSWORD as Sensitive.
# ==============================================================================
#
# Rule: secrets are never committed and never get defaults.
# A blank value below means "not configured". The app treats a missing
# REQUIRED key as a boot error and a missing OPTIONAL key as "feature off".

# ------------------------------------------------------------------------------
# REQUIRED — the app does not boot without these
# ------------------------------------------------------------------------------

# libSQL database URL for edge persistence
# (comments, highlights, ratings, progress, learn notes, public toggles).
# Get one free: turso db create soma-db && turso db show soma-db --url
# Official Turso name; the legacy TURSO_DB is still accepted as a fallback.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Auth token for the database above.
# Get it: turso db tokens create soma-db
# Vercel: mark as Sensitive (encrypted, write-only after save).
# Official Turso name; the legacy TURSO_TOKEN is still accepted as a fallback.
TURSO_AUTH_TOKEN=your-turso-auth-token

# Master password for your private studio (login gate, author controls).
# Pick any strong string: openssl rand -base64 32
# Vercel: mark as Sensitive.
SITE_PASSWORD=your-secure-site-password

# ------------------------------------------------------------------------------
# OPTIONAL — AI providers (at least one enables margin AI and research chat;
# with none configured, reading, writing, and publishing work unchanged)
# ------------------------------------------------------------------------------

# Unified router for Claude, GPT, Gemini, Llama, Qwen via one endpoint.
OPENROUTER_API_KEY=

# Straitly AI gateway (100+ models, single endpoint).
STRAITLY_API_KEY=

# DeepSeek direct API.
DEEPSEEK_API_KEY=

# Google Gemini API.
GEMINI_API_KEY=
# Set to 1 to force-disable direct Gemini even when a key is present.
GEMINI_DISABLED=0

# Groq fast inference (Llama, Mixtral).
GROQ_API_KEY=

# Cerebras fast inference.
CEREBRAS_API_KEY=

# Unsplash API access key for in-app cover image search.
# Get one: https://unsplash.com/developers → "Register as a developer" → "New Application"
UNSPLASH_ACCESS_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — local development only (never set these in Vercel production)
# ------------------------------------------------------------------------------

# Son voice agent backend for oral tests. Defaults to http://localhost:7860.
# Only needed when running son locally alongside `npm run dev`.
VITE_SON_BACKEND_URL=

# Direct browser-to-Turso access for offline local work (LOCAL_API=1).
# WARNING: values here are baked into the shipped JS bundle.
# Never set VITE_TURSO_* in Vercel. Production always goes through /api/*.
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=
